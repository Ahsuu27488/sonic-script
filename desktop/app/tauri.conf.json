{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SonicScript",
  "version": "0.1.0",
  "identifier": "app.sonicscript",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self'; font-src 'self'"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico", "icons/icon.png"]
  }
}
