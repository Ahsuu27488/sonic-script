{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SonicScript",
  "version": "0.2.0",
  "identifier": "app.sonicscript",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self'; font-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "publisher": "SonicScript",
    "shortDescription": "Speak Urdu, Hindi or English; get Roman Urdu / Hinglish at the cursor",
    "copyright": "MIT License",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "installerHooks": "installer.nsh"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI3OTM3NTE1MkZBQjY1RkQKUldUOVphc3ZGWFdUSjk5QkRReGp3eFFGUzkvQ2hVZUEwYVpGdHR3cUxndFg3U09Mb2dCY1Z1bDgK",
      "endpoints": [
        "https://github.com/Ahsuu27488/sonic-script/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
